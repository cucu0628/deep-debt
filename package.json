{
  "name": "deep-debt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:crazygames",
    "build:web": "tsc --noEmit && vite build --mode web --outDir dist/web --emptyOutDir",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames --outDir dist/crazygames --emptyOutDir",
    "preview": "vite preview --outDir dist/web",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "~5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "license": "UNLICENSED"
}
